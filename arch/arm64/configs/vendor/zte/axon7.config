# ZTE Axon 7 (A2017G, ailsa_ii)
# Fragment applied on top of vendor/xiaomi/mi8996_defconfig:
#   TARGET_KERNEL_CONFIG := vendor/xiaomi/mi8996_defconfig vendor/zte/axon7.config

# Board: build only the Axon 7 DTB and append only it to Image.gz-dtb
CONFIG_MACH_ZTE_AXON7=y
CONFIG_BUILD_ARM64_APPENDED_DTB_IMAGE_NAMES="qcom/msm8996-v3-pmi8996-zte-axon7"

# Xiaomi-only hardware
# CONFIG_TSPDRV is not set
# CONFIG_TYPEC_TI_TUSB320 is not set
# CONFIG_LEDS_LP5562 is not set
# CONFIG_NFC_PN548 is not set
# CONFIG_SERIAL_NUM is not set
# CONFIG_HALL_SWITCH is not set
# CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_FORCE is not set

# Touch screen and capacitive keys: Synaptics RMI4 on BLSP2 QUP6
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_I2C=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_CORE=y
CONFIG_TOUCHSCREEN_SYNAPTICS_DSX_RMI_DEV=y

# Vibrator: PMI8996 LRA haptics (qcom,qpnp-haptics binding)
# CONFIG_QPNP_HAPTIC is not set
CONFIG_LEDS_QPNP_HAPTICS=y

# Hall sensor (flip cover)
CONFIG_SENSORS_HALL_AH1898=y

# USB Type-C controller (PI5USB302 or HD3SS3220, depending on the board)
CONFIG_USB_TYPEC=y
CONFIG_USB_PI5USB302=y
CONFIG_USB_HD3SS3220=y

# Goodix GF3118M fingerprint (gx_fpd opens /dev/goodix_fp)
CONFIG_INPUT_FINGERPRINT=y
CONFIG_FINGERPRINT_GOODIX_GF3118M=y

# Hang detection (a test boot that hangs in a driver panics and restarts:
# hung_task_panic/softlockup_panic on the command line of AXON7_TEST builds)
CONFIG_DETECT_HUNG_TASK=y
CONFIG_DEFAULT_HUNG_TASK_TIMEOUT=60
CONFIG_LOCKUP_DETECTOR=y

# NXP PN548 NFC (/dev/pn5xx for the NXP NFC HAL)
CONFIG_PN5XX_NFC=y

# AKM AK4961 audio codec (slimbus) and its machine driver (msm8996-ak496x)
CONFIG_AK4961_CODEC=y

# AK4490 Hi-Fi DAC with AK8157 PLL and ISL98608 supply (headphones; part of the AK4961 sound card)
CONFIG_SND_SOC_AK4490=y
